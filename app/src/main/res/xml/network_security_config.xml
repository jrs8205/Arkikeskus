<?xml version="1.0" encoding="utf-8"?>
<!--
  Vanhemmilta / OEM-laitteilta (esim. OnePlus 10 5G) puuttuu "Telia Root CA v2"
  luotettujen juurivarmenteiden varastosta. Se on suhteellisen uusi juuri
  (lisatty trust storeihin ~2022), joten Pixelilla se on, vanhemmilta puuttuu.

  Maanmittauslaitoksen rajapinnat
    - avoin-paikkatieto.maanmittauslaitos.fi  (paikkahaku / geokoodaus)
    - avoin-karttakuva.maanmittauslaitos.fi   (taustakartan WMTS-laatat)
  kayttavat ketjua  *.maanmittauslaitos.fi -> Telia Server CA v3 -> Telia Root CA v2.
  Ilman juurta laite ei loyda luottamusankkuria:
    java.security.cert.CertPathValidatorException: Trust anchor for certification path not found

  Korjaus: luotetaan bundlattuun Telia Root CA v2 -juureen JARJESTELMAN
  varmenteiden LISAKSI, ja vain maanmittauslaitos.fi-domaineilla. Muiden
  palveluiden (FMI, Digitraffic, HSL ym.) luottamus pysyy ennallaan.
  Korjaa seka HttpURLConnection-geokoodauksen (MmlGeocodingClient) etta
  MapLibren karttalaattahaun (RoadCamerasFragment).
-->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config>
        <domain includeSubdomains="true">maanmittauslaitos.fi</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/telia_root_ca_v2" />
        </trust-anchors>
    </domain-config>
</network-security-config>
