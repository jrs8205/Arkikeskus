<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup -säännöt (API 30): pilveen VAIN SharedPreferences-asetukset.
     Tietokanta (fsclock.db) jätetään pois: sisältää rajattoman anturi-/säähistorian
     (25 Mt kiintiöriski) ja Room on WAL-tilassa (kesken-checkpointin kopio voi
     korruptoitua). Lenkit turvataan manuaalisella varmuuskopiolla (BackupManager). -->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <!-- Automaattibackupin tila (SAF-URI, ajastus) on laitekohtainen — palautettuna toiselle
         laitteelle se näyttäisi valheellista päällä-tilaa ilman persistoitua lupaa. -->
    <exclude domain="sharedpref" path="auto_backup_prefs.xml" />
    <!-- Drive-varmuuskopion tila (frekvenssi, viimeisin kopio) on laite-/tilikohtainen. -->
    <exclude domain="sharedpref" path="drive_backup_prefs.xml" />
</full-backup-content>
