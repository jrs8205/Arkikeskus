<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: pilvibackup = vain asetukset (ks. backup_rules.xml perustelut);
     laitteelta laitteelle -siirto (D2D) = asetukset + tietokanta (ei kiintiötä,
     kopiointi tapahtuu sovelluksen ollessa pysäytettynä → WAL ei ongelma). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <!-- Laitekohtainen automaattibackup-tila pois (SAF-lupa ei siirry laitteelta toiselle) -->
        <exclude domain="sharedpref" path="auto_backup_prefs.xml" />
        <exclude domain="sharedpref" path="drive_backup_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="auto_backup_prefs.xml" />
        <exclude domain="sharedpref" path="drive_backup_prefs.xml" />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
