<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-kortti (tumma teema): pystygradientti #1C2128 -> #12161C, 26dp pyoristys, ohut reuna.
     Vastaa Claude Design -tokeneita card1/card2 + cardBorder rgba(255,255,255,.07). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FF1C2128"
        android:endColor="#FF12161C"
        android:type="linear" />
    <corners android:radius="26dp" />
    <stroke android:width="1dp" android:color="#12FFFFFF" />
</shape>
