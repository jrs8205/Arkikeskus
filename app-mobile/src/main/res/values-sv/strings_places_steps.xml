    <string name="steps_note_unavailable">Den här enheten har varken stegsensor eller Health Connect, så stegräknaren kan inte aktiveras.</string>
    <string name="steps_note_disabled">Stegräknaren är avstängd. Slå på den för att räkna dina steg.</string>
    <string name="steps_note_hc">Källa: Health Connect (anslutna enheter, t.ex. klocka eller ring). Antalet hämtas automatiskt; om klockans eller ringens app inte har synkroniserats till den här telefonen ännu, öppna den en gång.</string>
    <string name="steps_note_phone">Källa: telefonens egen stegräknare. Stegen uppdateras i realtid när du går. Om du vill kan du ansluta Health Connect (klocka eller ring) nedan.</string>
    <string name="steps_allow_activity">Tillåt fysisk aktivitet (telefonens stegräknare)</string>
    <string name="steps_use_hc">Använd Health Connect</string>
    <string name="steps_hc_desc">Health Connect samlar steg och andra hälsodata på ett ställe — du kan till exempel ansluta en smartklocka, en smart ring eller andra hälsoappar. Den är inte installerad som standard; utan den använder Arkikeskus telefonens egen stegräknare.</string>
    <string name="steps_hc_open">Öppna Health Connect</string>
    <string name="steps_hc_install">Installera Health Connect</string>
    <string name="steps_hc_read_calories">Läs även kalorier från Health Connect</string>
    <string name="steps_hc_refresh">Uppdatera från Health Connect</string>
    <string name="steps_hc_settings_failed">Det gick inte att öppna inställningarna för Health Connect</string>
