<?xml version="1.0" encoding="utf-8"?>
<!-- Reittihaku (HSL): Mistä/Minne (geokoodaus) + aikavalinta → planConnection-reitit.
     MobileMainActivityn sisäinen sektio (sama ☰-header), kuten Joukkoliikenne.
     Uudistettu ulkoasu: väritetyt lähtö/määränpää-pisteet + yhdysviiva, pyöreä swap-nappi,
     selkeä aikavalinta ja täysleveä ensisijainen "Hae reitit" -nappi. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mobile_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/route_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="Reittihaku"
            android:textColor="@color/mobile_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/route_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:text="Minne olet matkalla?"
            android:textColor="@color/mobile_text_muted"
            android:textSize="14sp" />

        <!-- Hakukortti: Mistä/Minne (väritetyt pisteet) + swap + aika + ensisijainen Hae reitit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/mobile_nav_surface"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Mistä -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/mobile_transit_dot"
                            android:backgroundTint="@color/mobile_accent" />

                        <EditText
                            android:id="@+id/route_from"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/mobile_card_bg"
                            android:hint="Mistä"
                            android:inputType="text"
                            android:maxLines="1"
                            android:padding="12dp"
                            android:textColor="@color/mobile_text_primary"
                            android:textColorHint="@color/mobile_text_muted"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/route_from_clear"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="2dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Tyhjennä lähtö"
                            android:gravity="center"
                            android:text="×"
                            android:textColor="@color/mobile_text_secondary"
                            android:textSize="24sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Yhdysviiva lähdöstä määränpäähän -->
                    <View
                        android:layout_width="2dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:background="@color/mobile_card_stroke" />

                    <!-- Minne -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/mobile_transit_dot"
                            android:backgroundTint="@color/mobile_warning_red" />

                        <EditText
                            android:id="@+id/route_to"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/mobile_card_bg"
                            android:hint="Minne (esim. Rautatieasema, osoite)"
                            android:inputType="text"
                            android:maxLines="1"
                            android:padding="12dp"
                            android:textColor="@color/mobile_text_primary"
                            android:textColorHint="@color/mobile_text_muted"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/route_to_clear"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="2dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Tyhjennä määränpää"
                            android:gravity="center"
                            android:text="×"
                            android:textColor="@color/mobile_text_secondary"
                            android:textSize="24sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/route_swap"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/mobile_fab_bg"
                    android:contentDescription="Vaihda suunta"
                    android:gravity="center"
                    android:text="⇅"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Aikavalinta (lähde/perillä klo) -->
            <TextView
                android:id="@+id/route_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/mobile_menu_item_bg"
                android:drawableEnd="@drawable/mobile_ic_unfold_more"
                android:drawablePadding="6dp"
                android:drawableTint="@color/mobile_text_muted"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingTop="11dp"
                android:paddingEnd="12dp"
                android:paddingBottom="11dp"
                android:text="Lähtö nyt"
                android:textColor="@color/mobile_text_primary"
                android:textSize="14sp" />

            <!-- Ensisijainen toiminto: korostettu täysleveä nappi -->
            <TextView
                android:id="@+id/route_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/mobile_route_primary_bg"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="Hae reitit"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/route_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:padding="28dp"
            android:textColor="@color/mobile_text_muted"
            android:textSize="15sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/route_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="20dp"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- Reitin osat -overlay (legs). Oma header takaisin-napilla. -->
    <LinearLayout
        android:id="@+id/route_detail_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mobile_bg"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/mobile_toolbar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/route_detail_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Takaisin"
                android:padding="12dp"
                android:src="@drawable/mobile_ic_arrow_back" />

            <TextView
                android:id="@+id/route_detail_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Reitti"
                android:textColor="@color/mobile_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/route_detail_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/mobile_nav_surface"
            android:lineSpacingExtra="2dp"
            android:padding="14dp"
            android:textColor="@color/mobile_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/route_detail_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="20dp"
            android:scrollbars="vertical" />
    </LinearLayout>
</FrameLayout>
