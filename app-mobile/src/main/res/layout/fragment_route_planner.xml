<?xml version="1.0" encoding="utf-8"?>
<!-- Reittihaku (HSL): kartta täyttää näkymän (oma sijainti näkyy), hakukentät + tulokset ja reitin
     valittua reitin osat samassa vedettävässä alapaneelissa (BottomSheet). Yksi jaettu kartta:
     reitin valinta piirtää reitin samaan karttaan ja paneeli vaihtuu osiin (takaisin-napilla hakuun). -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/route_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/route_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Takaisin (vain reitin osat -tilassa, kartan päällä). -->
    <ImageView
        android:id="@+id/route_detail_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="@drawable/mobile_fab_bg"
        android:contentDescription="Takaisin"
        android:elevation="12dp"
        android:padding="10dp"
        android:src="@drawable/mobile_ic_arrow_back"
        app:tint="#FFFFFF"
        android:visibility="gone" />

    <!-- Vedettävä alapaneeli: oletus puolivälissä, alas = iso kartta, ylös = täysi haku/osat. -->
    <LinearLayout
        android:id="@+id/route_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/mobile_sheet_bg"
        android:orientation="vertical"
        app:behavior_hideable="false"
        app:behavior_peekHeight="150dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/mobile_sheet_handle" />

        <!-- HAKUTILA: hakukortti (Mistä/Minne + swap + aika + Hae reitit). -->
        <LinearLayout
            android:id="@+id/route_search_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/route_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Reittihaku"
                android:textColor="@color/mobile_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/route_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:text="Minne olet matkalla?"
                android:textColor="@color/mobile_text_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/mobile_transit_dot"
                            android:backgroundTint="@color/mobile_accent" />

                        <EditText
                            android:id="@+id/route_from"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/mobile_card_bg"
                            android:hint="Mistä"
                            android:inputType="text"
                            android:maxLines="1"
                            android:padding="12dp"
                            android:textColor="@color/mobile_text_primary"
                            android:textColorHint="@color/mobile_text_muted"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/route_from_clear"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="2dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Tyhjennä lähtö"
                            android:gravity="center"
                            android:text="×"
                            android:textColor="@color/mobile_text_secondary"
                            android:textSize="24sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/route_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/mobile_menu_item_bg"
                        android:drawableEnd="@drawable/mobile_ic_unfold_more"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/mobile_text_muted"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="11dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="11dp"
                        android:text="Lähtö nyt"
                        android:textColor="@color/mobile_text_primary"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:background="@color/mobile_card_stroke" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/mobile_transit_dot"
                            android:backgroundTint="@color/mobile_warning_red" />

                        <EditText
                            android:id="@+id/route_to"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/mobile_card_bg"
                            android:hint="Minne (esim. Rautatieasema, osoite)"
                            android:inputType="text"
                            android:maxLines="1"
                            android:padding="12dp"
                            android:textColor="@color/mobile_text_primary"
                            android:textColorHint="@color/mobile_text_muted"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/route_to_clear"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="2dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Tyhjennä määränpää"
                            android:gravity="center"
                            android:text="×"
                            android:textColor="@color/mobile_text_secondary"
                            android:textSize="24sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/route_search"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/mobile_route_primary_bg"
                        android:gravity="center"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp"
                        android:text="Hae reitit"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/route_swap"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/mobile_fab_bg"
                    android:contentDescription="Vaihda suunta"
                    android:gravity="center"
                    android:text="⇅"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Suodattimet: kulkuväline (Kaikki/Bussi/Juna/...) + Vain suorat. Chipit luodaan koodista. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/route_filter_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </HorizontalScrollView>

        </LinearLayout>

        <!-- REITIN OSAT -TILA: otsikko + yhteenveto (GONE hakutilassa). -->
        <TextView
            android:id="@+id/route_detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Reitti"
            android:textColor="@color/mobile_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/route_detail_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:paddingStart="16dp"
            android:paddingTop="2dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:textColor="@color/mobile_text_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/route_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:padding="24dp"
            android:textColor="@color/mobile_text_muted"
            android:textSize="15sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/route_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="20dp"
            android:scrollbars="vertical" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/route_detail_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="20dp"
            android:scrollbars="vertical"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Paikannusnappi: kelluu paneelin yläreunan oikealla, liikkuu paneelin mukana.
         Harmaa = ei seuraa; sininen = keskitetty omaan sijaintiin (klikkaus palauttaa siihen). -->
    <ImageView
        android:id="@+id/route_loc_btn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:background="@drawable/mobile_loc_btn_bg"
        android:contentDescription="Keskitä omaan sijaintiin"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/mobile_ic_my_location_24" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
