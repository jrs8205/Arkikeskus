    <!-- Health Connect -perustelu -->
    <string name="settings_health_title">Use of health data</string>
    <string name="settings_health_why">Why does Arkikeskus ask for Health Connect permissions?</string>
    <string name="settings_health_reads">Arkikeskus reads steps and calories (active and total burned) from Health Connect so the Steps page can show your daily step count, a calorie estimate and daily, weekly and monthly history.</string>
    <string name="settings_health_privacy">The data is only used for display in this app and for the local HTML export that you create yourself. It is not sent over the network or shared with third parties. The app doesn\'t write anything to Health Connect.</string>
    <string name="settings_health_revoke">You can revoke the permissions at any time in Health Connect settings – the step counter then relies on the phone\'s own sensor.</string>
