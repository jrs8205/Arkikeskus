    <string name="steps_note_unavailable">This device has neither a step sensor nor Health Connect, so the step counter can\'t be turned on.</string>
    <string name="steps_note_disabled">The step counter is off. Turn it on to count your steps.</string>
    <string name="steps_note_hc">Source: Health Connect (connected devices, e.g. a watch or ring). The count is fetched automatically; if the watch or ring app hasn\'t synced to this phone yet, open it once.</string>
    <string name="steps_note_phone">Source: the phone\'s own step counter. Steps update in real time as you walk. If you like, you can connect Health Connect (watch or ring) below.</string>
    <string name="steps_allow_activity">Allow physical activity (phone step counter)</string>
    <string name="steps_use_hc">Use Health Connect</string>
    <string name="steps_hc_desc">Health Connect brings your steps and other health data together — you can connect, for example, a smartwatch, a smart ring or other health apps. It isn\'t installed by default; without it, Arkikeskus uses the phone\'s own step counter.</string>
    <string name="steps_hc_open">Open Health Connect</string>
    <string name="steps_hc_install">Install Health Connect</string>
