<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-kortti (vaalea teema): pystygradientti valkoinen -> #F4F6FB, 26dp pyoristys, ohut reuna.
     Vastaa Claude Design -tokeneita card1/card2 + cardBorder rgba(15,20,30,.08). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FFFFFFFF"
        android:endColor="#FFF4F6FB"
        android:type="linear" />
    <corners android:radius="26dp" />
    <stroke android:width="1dp" android:color="#140F141E" />
</shape>
