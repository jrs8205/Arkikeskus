<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sovelluksen itsepäivitys: ladatun APK:n asennuksen käynnistäminen. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lähtömuistutus (#4): aseta avoimet AlarmManager-muistutukset uudelleen laitteen
         uudelleenkäynnistyksen jälkeen (AlarmManager ei säilytä hälytyksiä bootin yli). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Lenkkiseuranta: foreground service (location) + ongoing-notifikaatio. Palvelu
         käynnistetään aina etualalta → ACCESS_BACKGROUND_LOCATIONia EI tarvita. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Lähilähtömuistutus (#4): tarkka AlarmManager-herätys ennen valittua lähtöä. USE_EXACT_ALARM
         on Android 13+:lla aina myönnetty (sideload, ei Play-kaupan rajoitusta); SCHEDULE_EXACT_ALARM
         kattaa Android 12:n. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <!-- Valinnainen: ilman tätä HC rajaa luvun 30 pv:ään ennen ensimmäistä lupahetkeä →
         pitkät historiat (8 vk / 6 kk / HTML-vienti) voisivat jäädä tyhjiksi. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <!-- Valinnainen: sallii askeltavoite-ilmoituksen lukea HC:tä taustatyössä (NotificationsWorker). -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="31" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- Package visibility: HC:hen kirjoittavien sovellusten (Oura, Pebble ym.) nimet
             lähde-erittelyyn — terveyssovellukset julkaisevat nämä intent-filterit. -->
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
            <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
        </intent>
    </queries>

    <!-- Auto Backup: asetukset varmuuskopioituvat Google Driveen ja palautuvat
         uudelleenasennuksessa (myös sideload, sama allekirjoitusavain). Pilvibackup
         = vain SharedPreferences; DB:n kattaa manuaalinen varmuuskopio (BackupManager). -->
    <application
        android:name="org.jrs82.fsclock.FsClockApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_mobile_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/MobileTheme">

        <!-- Lenkkiseuranta: GPS + askeleet + notifikaatio myös näytön ollessa lukittuna. -->
        <service
            android:name="org.jrs82.fsclock.mobile.WorkoutTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Lähilähtömuistutus (#4): AlarmManager herättää tämän, joka näyttää ilmoituksen. -->
        <receiver
            android:name="org.jrs82.fsclock.mobile.DepartureReminderReceiver"
            android:exported="false" />

        <!-- Lähtömuistutusten uudelleenasetus laitteen uudelleenkäynnistyksen / sovelluspäivityksen
             jälkeen. BOOT_COMPLETED + MY_PACKAGE_REPLACED ovat suojattuja järjestelmäbroadcasteja. -->
        <receiver
            android:name="org.jrs82.fsclock.mobile.DepartureBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Health Connect: perustelunäkymä (Android 13 ja vanhemmat). Ohut Compose-näyttö. -->
        <activity
            android:name="org.jrs82.fsclock.mobile.HealthRationaleActivity"
            android:exported="true"
            android:label="@string/app_mobile_name"
            android:theme="@style/MobileComposeTheme">
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Health Connect: perustelunäkymä (Android 14+). Vain järjestelmä voi käynnistää. -->
        <activity-alias
            android:name="org.jrs82.fsclock.mobile.ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity="org.jrs82.fsclock.mobile.HealthRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Uusi Compose-pohjainen päänäkymä = sovelluksen oletuskäynnistys (launcher).
             Asetukset on sen sisäinen overlay (ei enää omaa Activitya). -->
        <activity
            android:name="org.jrs82.fsclock.mobile.MobileComposeMainActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_mobile_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Arkikeskus.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Jaetun lenkkitiedoston (GPX/TCX) avaus: tiedostonhallinta/sähköposti (VIEW)
                 ja jakovalikko (SEND). singleTask → olemassa oleva instanssi saa onNewIntentin.
                 octet-stream mukana, koska Android EI tunne .gpx/.tcx-päätteitä (tiedosto-
                 hallinnat ja WhatsApp tarjoavat ne tuntemattomana binäärinä) — tuonti
                 tunnistaa sisällön ja ilmoittaa siististi jos tiedosto ei ole lenkki. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/vnd.garmin.tcx+xml" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/vnd.garmin.tcx+xml" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Etusivun korttien nakyvyys + jarjestely (raahaus). Avataan asetuksista. -->
        <activity
            android:name="org.jrs82.fsclock.mobile.MobileWidgetOrderActivity"
            android:exported="false"
            android:label="@string/mobile_pref_widget_order"
            android:parentActivityName="org.jrs82.fsclock.mobile.MobileComposeMainActivity"
            android:theme="@style/MobileComposeTheme" />

        <!-- Aito uudelleenkäynnistys (varmuuskopion palautus): erillinen prosessi käynnistää
             pääactivityn kylmänä → splash näkyy. Ks. RestartActivity. -->
        <activity
            android:name="org.jrs82.fsclock.mobile.RestartActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:process=":restart"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name="org.jrs82.fsclock.history.HistoryActivity"
            android:exported="false"
            android:label="@string/history_title"
            android:parentActivityName="org.jrs82.fsclock.mobile.MobileComposeMainActivity"
            android:theme="@style/MobileSettingsTheme" />

        <!-- Ladatun päivitys-APK:n jakaminen pakettiasentajalle. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
